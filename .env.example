# Open Platform app credentials. Do not commit real values.
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=replace_me

# Absolute path to a pre-adapted Agent folder.
AGENT_DIR=./examples/echo-agent

# Optional: default model alias from models.yaml.
DEFAULT_MODEL=deepseek-chat

# Set the key needed by the chosen model provider.
DEEPSEEK_API_KEY=replace_me
OPENAI_API_KEY=replace_me
ANTHROPIC_API_KEY=replace_me

# Required when running `feishu-agent codex run`. Keep the conversation map
# outside the repository. union_id is stable across applications in one tenant
# and is preferred for multi-profile deployments; open_id is app-specific.
CODEX_AGENT_ALLOWED_OPEN_IDS=
CODEX_AGENT_ALLOWED_UNION_IDS=
CODEX_AGENT_ALLOWED_ROOTS=
CODEX_HISTORY_MAP=
